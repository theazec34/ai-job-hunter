POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_INVITE=true
# Comma-separated private account emails. Gmail aliases can create separate profiles.
REGISTRATION_ALLOWLIST=your-name+profile-one@gmail.com,your-name+profile-two@gmail.com

# OpenAI-compatible 4Geeks LLM Gateway
LLM_API_KEY=replace-with-your-private-api-key
LLM_BASE_URL=https://llm.4geeks.ai/v1
LLM_MODEL=madrid-spain/opnerouter/openai/gpt-6-luna
LLM_TIMEOUT_SECONDS=60

# Optional job sources
ENABLE_EURES_CONNECTOR=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
